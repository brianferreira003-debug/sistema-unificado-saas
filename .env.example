# ═══════════════════════════════════════════
# Sistema Unificado SaaS v3.0 - Variables de entorno
# ═══════════════════════════════════════════
# Renombrar a .completar con tus valores reales

# Clave secreta para sesiones (generá una con: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=cambiar-esto-por-un-token-aleatorio

# Puerto (Render/Railway lo ponen automáticamente)
PORT=5000

# Debug (0 en producción)
FLASK_DEBUG=0

# Google OAuth para Drive (opcional, por tenant)
# GOOGLE_CREDENTIALS_FILE=ruta/a/oauth_client.json
